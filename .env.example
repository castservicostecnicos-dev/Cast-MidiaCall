# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CLOUDFLARE PAGES / WORKERS CONFIGURATION:
# VITE_API_URL: (Opcional) URL pública do backend caso o frontend esteja hospedado no Cloudflare Pages
# e o backend esteja em outro servidor/domínio (ex: https://api.meudominio.com.br).
# Se deixado em branco, utiliza as rotas relativas /api (recomendado com o Edge Proxy functions/api/[[path]].ts).
VITE_API_URL=""

# BACKEND_URL: (Opcional) URL de destino para o Edge Function reverso do Cloudflare Pages (functions/api/[[path]].ts).
# Configure no painel do Cloudflare Pages: Configurações > Variáveis de ambiente.
BACKEND_URL=""
